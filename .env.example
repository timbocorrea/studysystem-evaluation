# Variáveis públicas consumidas pelo frontend
# Supabase: https://supabase.com/dashboard → Your Project → Settings → API

# URL pública do seu projeto Supabase
VITE_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co

# Chave anônima para autenticação pública (seguro expor no frontend)
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# Dropbox (opcional)
# Get your app key from: https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=<YOUR_DROPBOX_APP_KEY>

# GEMINI_API_KEY e GROQ_API_KEY são secrets server-side das Edge Functions.
# Não copie essas chaves para este arquivo nem para variáveis VITE_*.
